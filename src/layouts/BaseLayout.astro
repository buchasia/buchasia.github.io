---
const { title = 'Cogito Ergo Sum', description = 'The personal blog of Dr. Chhitiz Buchasia.' } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | Dr. Chhitiz Buchasia</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/">Dr. Chhitiz Buchasia</a>
        <nav aria-label="Primary navigation">
          <a href="/posts/">Posts</a>
          <a href="/about/">About</a>
          <a href="/tags/">Tags</a>
          <a href="/search/">Search</a>
          <a href="https://www.credly.com/users/chhitiz-buchasia/badges/credly">Credly</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>Copyright © {new Date().getFullYear()} | All rights reserved.</span>
        <div>
          <a href="https://www.linkedin.com/in/chhitizbuchasia/">LinkedIn</a>
          <a href="https://www.strava.com/athletes/64546861">Strava</a>
          <a href="https://github.com/buchasia">GitHub</a>
          <a href="https://www.credly.com/users/chhitiz-buchasia/badges/credly">Credly</a>
        </div>
      </footer>
    </div>
  </body>
</html>
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap');
  @import url('https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css');
  :root { color-scheme:dark; --page-width:1040px; --ink:#f1f3f2; --muted:#a5afab; --line:#34403d; --paper:#111716; --accent:#65b5e8; --wash:#1d2927; }
  * { box-sizing:border-box; }
  html { background:var(--paper); color:var(--ink); font-family:'DM Sans', sans-serif; }
  body { margin:0; }
  a { color:inherit; }
  .site-shell { width:min(100% - 64px, var(--page-width)); margin:auto; padding:24px 0 16px; }
  .site-header { display:flex; align-items:center; justify-content:space-between; gap:24px; padding-bottom:22px; border-bottom:1px solid var(--line); }
  .brand { color:var(--ink); font-weight:700; text-decoration:none; letter-spacing:-.02em; }
  nav, .site-footer div { display:flex; gap:22px; font-size:.82rem; }
  nav a, .site-footer a { text-decoration:none; }
  nav a:hover, .site-footer a:hover { color:var(--accent); }
  main { min-height:70vh; }
  .site-footer { display:flex; justify-content:space-between; gap:24px; padding:24px 0 8px; margin-top:80px; border-top:1px solid var(--line); color:var(--muted); font-size:.78rem; }
  .hero { padding:58px 0 42px; }
  .eyebrow { margin:0 0 16px; color:var(--accent); font-size:.72rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }
  h1, h2 { letter-spacing:-.045em; line-height:1.04; }
  h1 { margin:0 0 22px; font-size:2.35rem; }
  h2 { margin:0 0 12px; font-size:1.55rem; }
  .hero-copy { max-width:540px; color:var(--muted); font-family:'Source Serif 4', serif; font-size:1.05rem; line-height:1.65; }
  .hero-copy p { margin:0 0 12px; }
  .intro { display:flex; justify-content:space-between; gap:24px; padding:22px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .intro p { margin:0; }
  .section-label { color:var(--accent); font-size:.72rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }
  .posts { margin-top:42px; }
  .post-row { display:block; padding:22px 0; border-top:1px solid var(--line); text-decoration:none; }
  .post-row time { color:var(--muted); font-size:.76rem; }
  .post-row h3 { margin:8px 0; font-size:1.2rem; letter-spacing:-.025em; }
  .post-row p { margin:0; max-width:600px; color:var(--muted); line-height:1.55; }
  .post-row:hover h3 { color:var(--accent); }
  .search-result[hidden] { display:none; }
  .article { width:100%; margin:76px auto 0; }
  .article-header { margin-bottom:48px; }
  .article h1 { max-width:16ch; font-size:clamp(2.4rem,6vw,4.5rem); }
  .article-date { color:var(--accent); font-size:.78rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
  .prose { font-family:'Source Serif 4', serif; font-size:1.12rem; line-height:1.8; }
  .prose h2, .prose h3 { font-family:'DM Sans', sans-serif; margin-top:2.5em; }
  .prose img { max-width:100%; height:auto; }
  .prose pre { overflow:auto; padding:20px; background:#202c2a; color:#eef5f2; font-size:.86rem; }
  .prose blockquote { margin:24px 0; padding-left:20px; border-left:3px solid var(--accent); color:var(--muted); }
  .katex { color:var(--ink); }
  .about { width:100%; margin:80px auto 0; }
  .about h1 { max-width:none; }
  .about p { max-width:620px; font-family:'Source Serif 4', serif; font-size:1.2rem; line-height:1.7; }
  .tag-groups { margin-top:48px; }
  .tag-group { margin-top:44px; }
  .tag-group h2 { color:var(--accent); font-size:1.25rem; }
  .search-label { display:block; margin-top:40px; margin-bottom:10px; color:var(--muted); font-size:.82rem; }
  .search-input { width:100%; padding:14px 16px; border:1px solid var(--line); border-radius:0; background:var(--wash); color:var(--ink); font:inherit; }
  .search-input:focus { outline:2px solid var(--accent); outline-offset:2px; }
  .search-status { color:var(--muted); font-family:'DM Sans', sans-serif !important; font-size:.82rem !important; }
  @media (max-width: 640px) { .site-shell { width:calc(100% - 36px); } .site-header, .site-footer { align-items:flex-start; flex-direction:column; } .hero { grid-template-columns:1fr; gap:24px; padding:58px 0 40px; } .intro { display:block; } .intro p + p { margin-top:10px; } .post-row { grid-template-columns:1fr; gap:8px; } .article, .about { margin-top:48px; } }
</style>
