---
import SocialLinks from '../components/SocialLinks.astro'
import { localizedPath, t, type Lang } from '../utils/i18n'

type Props = {
  title?: string
  description?: string
  lang?: Lang
  altPath?: string
}

const {
  title = 'Cogito Ergo Sum',
  description = 'The personal blog of Dr. Chhitiz Buchasia.',
  lang = 'en' as Lang,
  altPath = '/',
} = Astro.props
const dict = t(lang)
const otherLang: Lang = lang === 'en' ? 'de' : 'en'
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="stylesheet" href="/katex/katex.min.css" />
    <link rel="alternate" type="application/rss+xml" title={lang === 'de' ? 'RSS-Feed' : 'RSS feed'} href={localizedPath(lang, '/rss.xml')} />
    <title>{title} | Dr. Chhitiz Buchasia</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={localizedPath(lang, '/')}>Dr. Chhitiz Buchasia</a>
        <div class="header-actions">
          <nav aria-label="Primary navigation">
            <a href={localizedPath(lang, '/posts/')}>{dict.nav.posts}</a>
            <a href={localizedPath(lang, '/runs/')}>{dict.nav.runs}</a>
            <a href={localizedPath(lang, '/about/')}>{dict.nav.about}</a>
            <a href={localizedPath(lang, '/tags/')}>{dict.nav.tags}</a>
            <a href={localizedPath(lang, '/search/')}>{dict.nav.search}</a>
            <a href={localizedPath(otherLang, altPath)} aria-label={t(otherLang).langSwitch.ariaLabel} hreflang={otherLang}>
              {t(otherLang).langSwitch.label}
            </a>
          </nav>
          <SocialLinks size="large" />
        </div>
      </header>
      {dict.translationNotice && (
        <p class="translation-notice" role="note">{dict.translationNotice}</p>
      )}
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>{dict.footer(new Date().getFullYear())}</span>
        <div class="footer-links">
          <a href={localizedPath(lang, '/privacy/')}>{lang === 'de' ? 'Datenschutz' : 'Privacy'}</a>
          <a href={localizedPath(lang, '/licenses/')}>{lang === 'de' ? 'Lizenzen' : 'Licenses'}</a>
          <a href={localizedPath(lang, '/rss.xml')}>{lang === 'de' ? 'RSS-Feed' : 'RSS feed'}</a>
          <button type="button" class="privacy-settings" data-privacy-settings>{lang === 'de' ? 'Cookie-Einstellungen' : 'Cookie settings'}</button>
          <SocialLinks className="footer-social-links" />
        </div>
      </footer>
    </div>
    <aside class="consent-banner" data-consent-banner hidden role="dialog" aria-labelledby="consent-title" aria-describedby="consent-description">
      <div>
        <strong id="consent-title">{lang === 'de' ? 'Analyse-Cookies' : 'Analytics cookies'}</strong>
        <p id="consent-description">
          {lang === 'de'
            ? 'Ich möchte verstehen, wie Besucher diese Website nutzen. Microsoft Clarity wird nur nach Ihrer Zustimmung geladen.'
            : 'I use Microsoft Clarity to understand how visitors use this website. It is loaded only after your consent.'}
          {' '}<a href={localizedPath(lang, '/privacy/')}>{lang === 'de' ? 'Mehr erfahren' : 'Learn more'}</a>
        </p>
      </div>
      <div class="consent-actions">
        <button type="button" class="consent-reject" data-consent-reject>{lang === 'de' ? 'Ablehnen' : 'Reject'}</button>
        <button type="button" class="consent-accept" data-consent-accept>{lang === 'de' ? 'Akzeptieren' : 'Accept'}</button>
      </div>
    </aside>
  </body>
</html>
<script>
  type ConsentValue = 'granted' | 'denied'
  type ClarityFunction = ((...args: unknown[]) => void) & { q?: unknown[][] }
  const clarityWindow = window as Window & { clarity?: ClarityFunction }
  const consentKey = 'clarity-consent'
  const banner = document.querySelector<HTMLElement>('[data-consent-banner]')
  const grantClarityConsent = () => {
    if (clarityWindow.clarity) clarityWindow.clarity('consentv2', { ad_storage: 'granted', analytics_storage: 'granted' })
  }
  const loadClarity = () => {
    if (clarityWindow.clarity) { grantClarityConsent(); return }
    clarityWindow.clarity = function(...args: unknown[]) {
      const clarity = clarityWindow.clarity
      if (clarity) (clarity.q ??= []).push(args)
    }
    const script = document.createElement('script')
    script.async = true
    script.src = 'https://www.clarity.ms/tag/ykpeaidgbu'
    document.head.appendChild(script)
  }
  const showBanner = () => { if (banner) banner.hidden = false }
  const saveConsent = (value: ConsentValue) => {
    localStorage.setItem(consentKey, value)
    if (value === 'granted') loadClarity()
    if (value === 'denied' && clarityWindow.clarity) clarityWindow.clarity('consent', false)
    if (banner) banner.hidden = true
  }
  const storedConsent = localStorage.getItem(consentKey)
  if (storedConsent === 'granted') loadClarity()
  else if (!storedConsent) showBanner()
  document.querySelector('[data-consent-accept]')?.addEventListener('click', () => saveConsent('granted'))
  document.querySelector('[data-consent-reject]')?.addEventListener('click', () => saveConsent('denied'))
  document.querySelector('[data-privacy-settings]')?.addEventListener('click', () => {
    saveConsent('denied')
    localStorage.removeItem(consentKey)
    showBanner()
  })
</script>
<style is:global>
  @font-face { font-family:'DM Sans'; font-style:normal; font-weight:400; font-display:swap; src:url('/fonts/dm-sans/dm-sans-400-ext.woff2') format('woff2'); unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF; }
  @font-face { font-family:'DM Sans'; font-style:normal; font-weight:400; font-display:swap; src:url('/fonts/dm-sans/dm-sans-400.woff2') format('woff2'); unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
  @font-face { font-family:'DM Sans'; font-style:normal; font-weight:500; font-display:swap; src:url('/fonts/dm-sans/dm-sans-500-ext.woff2') format('woff2'); unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF; }
  @font-face { font-family:'DM Sans'; font-style:normal; font-weight:500; font-display:swap; src:url('/fonts/dm-sans/dm-sans-500.woff2') format('woff2'); unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
  @font-face { font-family:'DM Sans'; font-style:normal; font-weight:700; font-display:swap; src:url('/fonts/dm-sans/dm-sans-700-ext.woff2') format('woff2'); unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF; }
  @font-face { font-family:'DM Sans'; font-style:normal; font-weight:700; font-display:swap; src:url('/fonts/dm-sans/dm-sans-700.woff2') format('woff2'); unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
  @font-face { font-family:'Source Serif 4'; font-style:normal; font-weight:400; font-display:swap; src:url('/fonts/source-serif-4/source-serif-4-400-ext.woff2') format('woff2'); unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF; }
  @font-face { font-family:'Source Serif 4'; font-style:normal; font-weight:400; font-display:swap; src:url('/fonts/source-serif-4/source-serif-4-400.woff2') format('woff2'); unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
  @font-face { font-family:'Source Serif 4'; font-style:normal; font-weight:600; font-display:swap; src:url('/fonts/source-serif-4/source-serif-4-600-ext.woff2') format('woff2'); unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF; }
  @font-face { font-family:'Source Serif 4'; font-style:normal; font-weight:600; font-display:swap; src:url('/fonts/source-serif-4/source-serif-4-600.woff2') format('woff2'); unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
  :root { color-scheme:dark; --page-width:1040px; --ink:#f1f3f2; --muted:#a5afab; --line:#34403d; --paper:#111716; --accent:#65b5e8; --wash:#1d2927; --font-size-body:1rem; --font-size-reading:1.1rem; --font-size-small:.8rem; --font-size-label:.75rem; --font-size-post-title:1.2rem; --font-size-h1:2.35rem; --font-size-h2:1.55rem; }
  * { box-sizing:border-box; }
  html { background:var(--paper); color:var(--ink); font-family:'DM Sans', sans-serif; font-size:var(--font-size-body); }
  body { margin:0; }
  a { color:inherit; }
  .site-shell { width:min(100% - 64px, var(--page-width)); margin:auto; padding:24px 0 16px; }
  .site-header { display:flex; align-items:center; justify-content:space-between; gap:24px; padding-bottom:22px; border-bottom:1px solid var(--line); }
  .translation-notice { margin:18px 0 0; padding:10px 14px; border:1px solid var(--line); background:var(--wash); color:var(--muted); font-size:var(--font-size-small); }
  .header-actions { display:flex; align-items:center; gap:24px; }
  .social-links { display:flex; gap:10px; }
  .social-links a { display:grid; place-items:center; width:32px; height:32px; border:1px solid var(--line); }
  .social-links a:hover { border-color:var(--accent); background:var(--wash); }
  .social-links img { display:block; }
  .github-icon { filter: invert(95%) sepia(8%) saturate(135%) hue-rotate(104deg) brightness(101%) contrast(96%); }
  .linkedin-icon { filter: invert(36%) sepia(98%) saturate(1200%) hue-rotate(177deg) brightness(86%) contrast(95%); }
  .strava-icon { filter: invert(42%) sepia(97%) saturate(2100%) hue-rotate(353deg) brightness(102%) contrast(103%); }
  .credly-icon { filter: invert(49%) sepia(96%) saturate(1928%) hue-rotate(358deg) brightness(103%) contrast(103%); }
  .brand { color:var(--ink); font-weight:700; text-decoration:none; letter-spacing:-.02em; }
  nav, .site-footer div { display:flex; gap:22px; font-size:var(--font-size-small); }
  .footer-links { align-items:center; gap:16px !important; }
  .footer-social-links { gap:16px !important; }
  nav a, .site-footer a { text-decoration:none; }
  .privacy-settings { padding:0; border:0; background:none; color:inherit; cursor:pointer; font:inherit; }
  .privacy-settings:hover { color:var(--accent); }
  .consent-banner { position:fixed; right:20px; bottom:20px; z-index:10; display:flex; align-items:center; justify-content:space-between; gap:24px; width:min(100% - 40px, 720px); padding:18px 20px; border:1px solid var(--line); background:var(--wash); box-shadow:0 10px 30px #0008; }
  .consent-banner[hidden] { display:none; }
  .consent-banner strong { font-size:var(--font-size-small); }
  .consent-banner p { max-width:520px; margin:6px 0 0; color:var(--muted); font-size:var(--font-size-small); line-height:1.5; }
  .consent-banner a { color:var(--accent); }
  .consent-actions { display:flex; flex-shrink:0; gap:10px; }
  .consent-actions button { padding:9px 13px; border:1px solid var(--line); background:transparent; color:var(--ink); cursor:pointer; font:inherit; font-size:var(--font-size-small); }
  .consent-actions .consent-accept { border-color:var(--accent); background:var(--accent); color:#071016; }
  nav a:hover, .site-footer a:hover { color:var(--accent); }
  main { min-height:70vh; }
  .site-footer { display:flex; justify-content:space-between; gap:24px; padding:24px 0 8px; margin-top:80px; border-top:1px solid var(--line); color:var(--muted); font-size:var(--font-size-small); }
  .hero { padding:58px 0 42px; }
  .eyebrow { margin:0 0 16px; color:var(--accent); font-size:var(--font-size-label); font-weight:700; letter-spacing:.14em; text-transform:uppercase; }
  h1, h2 { letter-spacing:-.045em; line-height:1.04; }
  h1 { margin:0 0 22px; font-size:var(--font-size-h1); }
  h2 { margin:0 0 12px; font-size:var(--font-size-h2); }
  .hero-copy { color:var(--muted); font-family:'Source Serif 4', serif; font-size:var(--font-size-reading); line-height:1.65; }
  .hero-copy p { margin:0 0 12px; }
  .intro { display:flex; justify-content:space-between; gap:24px; padding:22px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .intro p { margin:0; }
  .section-label { color:var(--accent); font-size:var(--font-size-label); font-weight:700; letter-spacing:.14em; text-transform:uppercase; }
  .posts { margin-top:42px; }
  .post-row { display:block; padding:22px 0; border-top:1px solid var(--line); text-decoration:none; }
  .post-row time { color:var(--muted); font-size:var(--font-size-small); }
  .post-meta { display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin:0; color:var(--muted); font-size:var(--font-size-small); }
  .reading-time { padding:3px 8px; line-height:1.2; border:1px solid var(--line); color:var(--muted); font-size:var(--font-size-label); font-weight:400; letter-spacing:normal; text-transform:none; white-space:nowrap; }
  .post-row h2, .post-row h3 { margin:8px 0; font-size:var(--font-size-post-title); letter-spacing:-.025em; }
  .post-row p { margin:0; color:var(--muted); line-height:1.55; }
  .post-row:hover h3 { color:var(--accent); }
  .search-result[hidden] { display:none; }
  .pagination { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:20px; margin-top:28px; padding-top:20px; border-top:1px solid var(--line); color:var(--muted); font-size:var(--font-size-small); text-align:center; }
  .pagination a { color:var(--accent); text-decoration:none; }
  .pagination a:last-child { text-align:right; }
  .article { width:100%; margin:48px auto 0; }
  .article-header { margin-bottom:32px; }
  .article h1 { max-width:none; font-size:clamp(1.75rem,3.5vw,2.35rem); line-height:1.15; margin:0 0 16px; }
  .article-date { display:flex; flex-wrap:wrap; align-items:center; gap:10px; color:var(--accent); font-size:var(--font-size-small); font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
  .post-tags { display:flex; flex-wrap:wrap; gap:8px; margin-top:18px; }
  .post-tags a { padding:5px 9px; border:1px solid var(--line); color:var(--muted); font-size:var(--font-size-label); text-decoration:none; }
  .post-tags a:hover { border-color:var(--accent); color:var(--accent); }
  .prose { font-family:'Source Serif 4', serif; font-size:var(--font-size-reading); line-height:1.8; }
  .prose h2, .prose h3 { font-family:'DM Sans', sans-serif; margin-top:2.5em; }
  .prose img { max-width:100%; height:auto; }
  .prose pre { overflow:auto; padding:20px; background:#202c2a; color:#eef5f2; font-size:var(--font-size-small); }
  .prose blockquote { margin:24px 0; padding-left:20px; border-left:3px solid var(--accent); color:var(--muted); }
  .katex { color:var(--ink); }
  .prose .katex-display { max-width:100%; overflow-x:auto; overflow-y:hidden; padding:4px 0; }
  .about { width:100%; margin:80px auto 0; }
  .about h1 { max-width:none; }
  .about p { font-family:'Source Serif 4', serif; font-size:var(--font-size-reading); line-height:1.7; }
  .tag-groups { margin-top:48px; }
  .tag-group { margin-top:44px; }
  .tag-group h2 { color:var(--accent); font-size:var(--font-size-post-title); }
  .tag-link { display:inline-block; margin:0 8px 8px 0; padding:10px 14px; border:1px solid var(--line); color:var(--muted); text-decoration:none; }
  .tag-link:hover { border-color:var(--accent); color:var(--accent); }
  .search-label { display:block; margin-top:40px; margin-bottom:10px; color:var(--muted); font-size:var(--font-size-small); }
  .search-input { width:100%; padding:14px 16px; border:1px solid var(--line); border-radius:0; background:var(--wash); color:var(--ink); font:inherit; }
  .search-input:focus { outline:2px solid var(--accent); outline-offset:2px; }
  .search-status { color:var(--muted); font-family:'DM Sans', sans-serif; font-size:var(--font-size-small); }
  @media (max-width: 640px) { .site-shell { width:calc(100% - 36px); } .site-header, .site-footer, .header-actions { align-items:flex-start; flex-direction:column; } .footer-links { align-items:flex-start !important; flex-direction:column; gap:12px !important; } .consent-banner { right:18px; bottom:18px; width:calc(100% - 36px); align-items:stretch; flex-direction:column; gap:14px; } .consent-actions { justify-content:flex-end; } .hero { grid-template-columns:1fr; gap:24px; padding:58px 0 40px; } .intro { display:block; } .intro p + p { margin-top:10px; } .post-row { grid-template-columns:1fr; gap:8px; } .article, .about { margin-top:48px; } }
</style>
