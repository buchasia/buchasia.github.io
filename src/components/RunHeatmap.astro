---
import { type Lang } from '../utils/i18n'
const { intensity = [], year, lang = 'en' as Lang } = Astro.props as { intensity?: number[]; year: string | number; lang?: Lang }
const labels = lang === 'de'
  ? { consistency: 'Jährliche Konstanz', activity: 'Laufaktivitäten für', meters: 'Meter', less: 'Weniger', more: 'Mehr', activeDays: 'aktive Tage' }
  : { consistency: 'Yearly Consistency', activity: 'Running activity for', meters: 'meters', less: 'Less', more: 'More', activeDays: 'active days' }
const dateFormatter = new Intl.DateTimeFormat(lang === 'de' ? 'de-DE' : 'en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' })
const activeDays = intensity.filter(distance => distance > 0).length
const totalDistance = intensity.reduce((sum, distance) => sum + distance, 0)
const startOffset = new Date(Date.UTC(Number(year), 0, 1)).getUTCDay()
const paddedIntensity = [...Array(startOffset).fill(null), ...intensity]
const monthNames = lang === 'de' ? ['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'] : ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
const weekdayNames = lang === 'de' ? ['So','Mo','Di','Mi','Do','Fr','Sa'] : ['Su','Mo','Tu','We','Th','Fr','Sa']
const monthPositions = monthNames.map((name, month) => ({ name, week: Math.floor((startOffset + Math.floor((Date.UTC(Number(year), month, 1) - Date.UTC(Number(year), 0, 1)) / 86400000)) / 7) }))
---

<section class="heatmap-container" aria-labelledby="heatmap-title">
  <div class="heatmap-header">
    <h2 id="heatmap-title" class="label">{labels.consistency}</h2>
    <span class="heatmap-summary">{activeDays} {labels.activeDays} · {Math.round(totalDistance).toLocaleString(lang === 'de' ? 'de-DE' : 'en-US')} {labels.meters}</span>
  </div>
  <div class="heatmap-legend" aria-label={`${labels.consistency} legend`}><span>{labels.less}</span><i class="legend-cell is-empty"></i><i class="legend-cell is-light"></i><i class="legend-cell is-full"></i><span>{labels.more}</span></div>
  <div class="heatmap-scroll"><div class="heatmap-months" aria-hidden="true" style="display:grid;grid-template-columns:repeat(53,12px);gap:2px;width:max-content">{monthPositions.map(month => <span style={`grid-column:${month.week + 1}`}>{month.name}</span>)}</div>
  <div class="heatmap-body"><div class="weekday-labels" aria-hidden="true">{weekdayNames.map(day => <span>{day}</span>)}</div><div class="heatmap-grid" role="img" aria-label={`${labels.activity} ${year}: ${activeDays} ${labels.activeDays}`} style="display:grid;grid-template-rows:repeat(7,12px);grid-auto-flow:column;grid-auto-columns:12px;width:max-content;gap:2px;padding:10px 0">
      {paddedIntensity.map((distance, i) => (
        <div 
          class:list={['heatmap-cell', i >= startOffset && new Date(Date.UTC(Number(year), 0, i - startOffset + 1)).getUTCDate() === 1 ? 'month-start' : undefined]}
          aria-hidden="true"
          style={`background-color: ${distance === null ? 'transparent' : distance && distance > 0 ? 'var(--accent)' : 'var(--wash)'}; opacity: ${distance === null ? 0 : distance && distance > 0 ? Math.max(0.18, Math.min(distance / 10000, 1)) : 1};`}
          title={distance !== null ? `${dateFormatter.format(new Date(Date.UTC(Number(year), 0, i - startOffset + 1)))}: ${distance} ${labels.meters}` : undefined}
        ></div>
      ))}
  </div></div></div>
</section>

<style>
  .heatmap-container {
    margin: 2rem 0;
  }
  .heatmap-header {
    margin-bottom: .35rem;
  }
  .heatmap-header { display:flex; justify-content:space-between; gap:1rem; align-items:baseline; }
  .heatmap-header .label {
    margin:0;
    font-size: var(--font-size-small);
    color: var(--muted);
    text-transform: uppercase;
  }
  .heatmap-summary { color:var(--muted); font-size:var(--font-size-small); }
  .heatmap-months { display:grid; grid-template-columns:repeat(53, 12px); gap:2px; width:max-content; margin:1rem 0 .35rem 1.8rem; color:var(--muted); font-size:var(--font-size-label); }
  .heatmap-months span { white-space:nowrap; }
  .heatmap-legend { display:flex; align-items:center; justify-content:flex-end; gap:.3rem; color:var(--muted); font-size:var(--font-size-label); }
  .legend-cell { width:12px; height:12px; border-radius:2px; background:var(--accent); }
  .legend-cell.is-empty { background:var(--wash); }
  .legend-cell.is-light { opacity:.35; }
  .heatmap-grid {
    display: grid;
    grid-template-rows: repeat(7, 12px);
    grid-auto-flow: column;
    grid-auto-columns: 12px;
    width: max-content;
    gap: 2px;
    padding: 10px 0;
  }
  .heatmap-scroll { overflow-x:auto; }
  .heatmap-body { display:flex; gap:.35rem; overflow:visible; }
  .weekday-labels { display:grid; grid-template-rows:repeat(7, 12px); gap:2px; padding:10px 0; color:var(--muted); font-size:.6rem; line-height:12px; }
  .heatmap-cell {
    width: 12px;
    height: 12px;
    border-radius: 2px;
  }
  .heatmap-cell.month-start { outline:1px solid var(--accent); outline-offset:1px; }
  @media (max-width:640px) { .heatmap-header { align-items:flex-start; flex-direction:column; } .heatmap-legend { justify-content:flex-start; } }
</style>
