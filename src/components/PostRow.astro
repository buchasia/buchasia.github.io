---
import { formatDate, formatReadingTime, getReadingTime, type BlogPost } from '../utils/posts'

type Props = {
  post: BlogPost
  showDate?: boolean
  showReadingTime?: boolean
  headingLevel?: 'h2' | 'h3'
  className?: string
  searchable?: boolean
}

const {
  post,
  showDate = true,
  showReadingTime = true,
  headingLevel = 'h3',
  className = '',
  searchable = false,
} = Astro.props
const searchText = `${post.data.title} ${post.data.description ?? ''}`
const readingTime = getReadingTime(post)
---
<a
  class={`post-row${className ? ` ${className}` : ''}`}
  data-search={searchable ? searchText : undefined}
  href={`/posts/${post.id}/`}
>
  {(showDate || showReadingTime) && (
    <p class="post-meta">
      {showDate && <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>}
      {showReadingTime && readingTime.minutes > 0 && (
        <span class="reading-time">{formatReadingTime(readingTime)}</span>
      )}
    </p>
  )}
  <div>
    {headingLevel === 'h2' ? <h2>{post.data.title}</h2> : <h3>{post.data.title}</h3>}
    <p>{post.data.description}</p>
  </div>
</a>
