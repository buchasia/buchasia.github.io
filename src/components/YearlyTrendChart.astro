---
import { formatDistance, formatDuration, formatElevation } from '../utils/runs'
import { type Lang } from '../utils/i18n'

type YearStats = { distance: number; duration: number; totalAscent: number; count: number }
const { data = {}, years = [], lang = 'en' as Lang } = Astro.props as { data?: Record<string, YearStats>; years?: string[]; lang?: Lang }
const labels = lang === 'de'
  ? { title: 'Jahrestrends', metric: 'Jahrestrend-Kennzahl', distance: 'Distanz', duration: 'Dauer', ascent: 'Höhenmeter', runs: 'Läufe', scale: 'Skala', note: 'Mit dem Schalter kannst du die Entwicklung von Distanz, Dauer, Höhenmetern oder Laufanzahl vergleichen.' }
  : { title: 'Yearly trends', metric: 'Yearly trend metric', distance: 'Distance', duration: 'Duration', ascent: 'Elevation', runs: 'Runs', scale: 'Scale', note: 'Use the selector to compare yearly distance, duration, elevation gain, or run count.' }
const metrics = [
  { key: 'distance', label: labels.distance, format: (value: number) => formatDistance(value, lang) },
  { key: 'duration', label: labels.duration, format: (value: number) => formatDuration(value, lang) },
  { key: 'ascent', label: labels.ascent, format: (value: number) => formatElevation(value, lang) },
  { key: 'runs', label: labels.runs, format: (value: number) => value.toLocaleString(lang === 'de' ? 'de-DE' : 'en-US') },
] as const
const valueFor = (year: string, metric: string) => {
  const item = data[year]
  if (metric === 'distance') return item?.distance ?? 0
  if (metric === 'duration') return item?.duration ?? 0
  if (metric === 'ascent') return item?.totalAscent ?? 0
  return item?.count ?? 0
}
const maxFor = (metric: string) => Math.max(...years.map(year => valueFor(year, metric)), 1)
---

<section class="yearly-trends" aria-labelledby="yearly-trends-title">
  <div class="chart-heading">
    <h2 id="yearly-trends-title" class="section-label">{labels.title}</h2>
    <div class="metric-toggle" role="group" aria-label={labels.metric}>
      {metrics.map((metric, index) => <button type="button" class:list={['toggle-button', { 'is-active': index === 0 }]} data-yearly-metric={metric.key} aria-pressed={index === 0 ? 'true' : 'false'}>{metric.label}</button>)}
    </div>
  </div>
  <div class="chart-wrap">
    <div class="chart-axis" aria-label={labels.scale}>
      {metrics.map((metric, index) => <div class:list={['axis-values', { 'is-hidden': index !== 0 }]} data-yearly-axis={metric.key} aria-hidden={index === 0 ? 'false' : 'true'}><span>{metric.format(maxFor(metric.key))}</span><span>{metric.format(maxFor(metric.key) / 2)}</span><span>{metric.format(0)}</span></div>)}
    </div>
    <div class="chart-grid">
      {years.map(year => <div class="year-column">
        {metrics.map((metric, index) => <div class:list={['year-bar', { 'is-hidden': index !== 0 }]} data-yearly-bars={metric.key} aria-hidden={index === 0 ? 'false' : 'true'}>
          <span style={`height:${(valueFor(year, metric.key) / maxFor(metric.key)) * 100}%`} title={`${year}: ${metric.format(valueFor(year, metric.key))}`}></span>
        </div>)}
        <span class="year-label">{year}</span>
      </div>)}
    </div>
  </div>
  <p class="chart-note">{labels.note}</p>
</section>

<script>
  const initYearlyTrendChart = () => {
    document.querySelectorAll<HTMLElement>('.yearly-trends').forEach((chart) => {
      const buttons = chart.querySelectorAll<HTMLButtonElement>('[data-yearly-metric]')
      const bars = chart.querySelectorAll<HTMLElement>('[data-yearly-bars]')
      const axes = chart.querySelectorAll<HTMLElement>('[data-yearly-axis]')
      const setMetric = (metric: string) => {
        bars.forEach((item) => {
          const active = item.dataset.yearlyBars === metric
          item.classList.toggle('is-hidden', !active)
          item.setAttribute('aria-hidden', String(!active))
        })
        axes.forEach((item) => {
          const active = item.dataset.yearlyAxis === metric
          item.classList.toggle('is-hidden', !active)
          item.setAttribute('aria-hidden', String(!active))
        })
        buttons.forEach((button) => {
          const active = button.dataset.yearlyMetric === metric
          button.classList.toggle('is-active', active)
          button.setAttribute('aria-pressed', String(active))
        })
      }
      buttons.forEach((button) => button.addEventListener('click', () => setMetric(button.dataset.yearlyMetric ?? 'distance')))
      setMetric('distance')
    })
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initYearlyTrendChart)
  else initYearlyTrendChart()
</script>

<style>
  .yearly-trends { margin:4rem 0 0; overflow-x:auto; }
  .chart-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .chart-heading .section-label { margin:0; }
  .metric-toggle { display:inline-flex; border:1px solid var(--line); border-radius:.35rem; overflow:hidden; }
  .toggle-button { border:0; border-right:1px solid var(--line); padding:.35rem .65rem; color:var(--muted); background:transparent; font:inherit; font-size:var(--font-size-small); cursor:pointer; }
  .toggle-button:last-child { border-right:0; }
  .toggle-button.is-active { color:var(--ink); background:var(--line); }
  .toggle-button:focus-visible { outline:2px solid currentColor; outline-offset:-2px; }
  .chart-wrap { display:grid; grid-template-columns:5.25rem minmax(24rem,1fr); gap:.5rem; align-items:start; min-width:30rem; margin-top:1rem; }
  .chart-axis { height:13rem; padding-top:.5rem; }
  .axis-values { display:flex; height:10rem; flex-direction:column; justify-content:space-between; color:var(--muted); font-size:.65rem; line-height:1; text-align:right; }
  .is-hidden { display:none !important; }
  .chart-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(2.5rem,1fr)); gap:.65rem; align-items:end; height:13rem; padding:.5rem 0 0; border-bottom:1px solid var(--line); background:repeating-linear-gradient(to bottom, transparent 0, transparent calc(25% - 1px), var(--line) 25%); }
  .year-column { display:flex; height:12.5rem; min-width:0; flex-direction:column; align-items:center; justify-content:flex-end; }
  .year-bar { display:flex; width:100%; height:10rem; align-items:flex-end; justify-content:center; }
  .year-bar span { display:block; width:min(2rem,70%); min-height:1px; background:var(--accent); }
  .year-label { margin-top:.5rem; color:var(--muted); font-size:var(--font-size-label); }
  .chart-note { margin:.75rem 0 0; color:var(--muted); font-size:var(--font-size-small); }
  @media (max-width:640px) { .chart-heading { align-items:flex-start; flex-direction:column; } .metric-toggle { max-width:100%; overflow-x:auto; } .toggle-button { white-space:nowrap; } }
</style>
