---
import type { Lang } from '../utils/i18n'

type Props = { lang: Lang }
const { lang } = Astro.props
const de = lang === 'de'
---
<section class="route-preview" data-route-preview data-locale={lang} aria-labelledby={`route-preview-title-${lang}`}>
  <h2 id={`route-preview-title-${lang}`}>{de ? 'Vorschau' : 'Preview'}</h2>
  <p class="route-preview-status" data-preview-status aria-live="polite">{de ? 'Wähle eine GPX-Datei aus, um die Vorschau zu sehen.' : 'Choose a GPX file to see the preview.'}</p>
  <div class="route-preview-frame" data-preview-frame hidden>
    <svg data-preview-svg role="img" preserveAspectRatio="xMidYMid meet">
      <title data-preview-svg-title>{de ? 'Routen-Artwork-Vorschau' : 'Route artwork preview'}</title>
      <desc data-preview-svg-description></desc>
      <g data-preview-artwork></g>
    </svg>
  </div>
  <p class="route-preview-meta" data-preview-meta aria-live="polite"></p>
</section>
<script>
  import { getArtworkDimensions, DEFAULT_ARTWORK_SETTINGS, type ArtworkSettings } from '../utils/artworkSettings'
  import { getPosterLayout } from '../utils/artworkLayout'
  import { getArtworkTemplate, DEFAULT_ARTWORK_TEMPLATE, type ArtworkTemplate } from '../utils/artworkTemplates'
  import { calculateGpxStatistics, formatGpxDateTime, formatGpxDistance, formatGpxDuration, formatGpxElevation, formatGpxPace, type GpxDistanceUnit } from '../utils/gpxStatistics'
  import { DEFAULT_VISIBLE_STATISTICS, type GpxVisibleStatistic } from '../utils/gpxVisibleStatistics'
  import { projectRoute } from '../utils/routeProjection'
  import type { ValidatedGpx } from '../utils/gpxValidationTypes'
  import type { GpxRouteSelectionOption } from '../utils/gpxRouteSelection'

  type SelectionDetail = { gpx: ValidatedGpx; option: GpxRouteSelectionOption }
  type SvgElement = SVGElement & { textContent: string | null }
  type ShadowTarget = 'route' | 'title' | 'statistics' | 'scale' | 'footer'

  document.querySelectorAll<HTMLElement>('[data-route-preview]').forEach((preview) => {
    const locale = preview.dataset.locale === 'de' ? 'de' : 'en'
    const status = preview.querySelector<HTMLElement>('[data-preview-status]')
    const frame = preview.querySelector<HTMLElement>('[data-preview-frame]')
    const svg = preview.querySelector<SVGSVGElement>('[data-preview-svg]')
    const artwork = preview.querySelector<SVGGElement>('[data-preview-artwork]')
    const description = preview.querySelector<SVGDescElement>('[data-preview-svg-description]')
    const meta = preview.querySelector<HTMLElement>('[data-preview-meta]')
    let selection: SelectionDetail | undefined
    let template: ArtworkTemplate = getArtworkTemplate(DEFAULT_ARTWORK_TEMPLATE)
    let settings: ArtworkSettings = { ...DEFAULT_ARTWORK_SETTINGS }
    let visibleStatistics = new Set<GpxVisibleStatistic>(DEFAULT_VISIBLE_STATISTICS)
    const svgNamespace = 'http://www.w3.org/2000/svg'
    const unavailable = locale === 'de' ? '—' : '—'
    const labels = locale === 'de'
      ? { distance: 'Distanz', recordedTime: 'Zeit', pace: 'Tempo', elevationGain: 'Höhenmeter', elevationLoss: 'Höhenverlust', elevationRange: 'Höhenbereich', startTime: 'Start', endTime: 'Ende', scale: 'Maßstab' }
      : { distance: 'Distance', recordedTime: 'Time', pace: 'Pace', elevationGain: 'Elevation gain', elevationLoss: 'Elevation loss', elevationRange: 'Elevation range', startTime: 'Start', endTime: 'End', scale: 'Scale' }
    const create = (name: string, attributes: Record<string, string>, text?: string): SvgElement => {
      const element = document.createElementNS(svgNamespace, name) as SvgElement
      Object.entries(attributes).forEach(([key, value]) => element.setAttribute(key, value))
      if (text !== undefined) element.textContent = text
      return element
    }
    const addText = (group: SVGGElement, text: string, x: number, y: number, size: number, color: string, weight = '400', anchor: 'start' | 'middle' = 'start', fontFamily = 'DM Sans') => group.appendChild(create('text', { x: String(x), y: String(y), fill: color, 'font-family': `${fontFamily}, sans-serif`, 'font-size': String(size), 'font-weight': weight, 'text-anchor': anchor }, text))
    const setStatus = (message: string, hasPreview = false) => {
      if (status) status.textContent = message
      if (frame) frame.hidden = !hasPreview
    }
    const render = () => {
      if (!selection || !svg || !artwork || !description) return
      const dimensions = getArtworkDimensions(settings)
      const appearance = template.appearance
      artwork.replaceChildren()
      svg.setAttribute('viewBox', `0 0 ${dimensions.widthPx} ${dimensions.heightPx}`)
      svg.style.backgroundColor = typeof appearance.background === 'string' ? appearance.background : 'transparent'
      const statisticKeys: GpxVisibleStatistic[] = ['distance', 'recordedTime', 'pace', 'elevationGain', 'elevationLoss', 'elevationRange', 'startTime', 'endTime']
      const selectedStatisticKeys = statisticKeys.filter(key => visibleStatistics.has(key))
      const layout = getPosterLayout({ width: dimensions.widthPx, height: dimensions.heightPx, routePadding: template.routePadding, hasTitle: Boolean(settings.title.trim()), statisticCount: selectedStatisticKeys.length, statisticColumns: template.statisticsColumns, composition: template.composition })
      const projection = projectRoute(selection.gpx, selection.option, dimensions.widthPx, dimensions.heightPx, layout.routePadding)
      if (!projection.hasDrawableRoute) {
        setStatus(locale === 'de' ? 'Für die Vorschau werden mindestens zwei verschiedene Punkte in einem sichtbaren Fragment benötigt.' : 'The preview needs at least two distinct points in one visible fragment.')
        if (meta) meta.textContent = ''
        return
      }
      const shadowIds = new Map<ShadowTarget, string>()
      const declaredShadows = template.definition.settings.shadows
      const declaredShadowEntries = Object.entries(declaredShadows) as [ShadowTarget, NonNullable<typeof declaredShadows[ShadowTarget]>][]
      const defs = create('defs', {})
      let backgroundFill = typeof appearance.background === 'string' ? appearance.background : 'transparent'
      if (typeof appearance.background !== 'string') {
        const gradientId = 'artwork-background-gradient'
        const gradient = create('linearGradient', { id: gradientId, x1: '0%', y1: '0%', x2: '100%', y2: '100%', gradientTransform: `rotate(${appearance.background.angle} 0.5 0.5)` })
        appearance.background.stops.forEach(stop => gradient.appendChild(create('stop', { offset: `${stop.position}%`, 'stop-color': stop.color })))
        defs.appendChild(gradient)
        backgroundFill = `url(#${gradientId})`
      }
      if (declaredShadowEntries.length) {
        declaredShadowEntries.forEach(([target, shadow]) => {
          if (!shadow.enabled || shadow.opacity <= 0 || (shadow.blur === 0 && shadow.offsetX === 0 && shadow.offsetY === 0)) return
          const id = `artwork-shadow-${target}`
          const filter = create('filter', { id, x: '-50%', y: '-50%', width: '200%', height: '200%' })
          filter.appendChild(create('feDropShadow', { dx: String(shadow.offsetX), dy: String(shadow.offsetY), stdDeviation: String(shadow.blur / 2), 'flood-color': shadow.color, 'flood-opacity': String(shadow.opacity) }))
          defs.appendChild(filter)
          shadowIds.set(target, id)
        })
      }
      if (defs.childElementCount) artwork.appendChild(defs)
      const background = create('rect', { x: '0', y: '0', width: String(dimensions.widthPx), height: String(dimensions.heightPx), fill: backgroundFill })
      artwork.appendChild(background)
      const shadowAttributes = (target: ShadowTarget): Record<string, string> => {
        const id = shadowIds.get(target)
        return id ? { filter: `url(#${id})` } : {}
      }
      const routeGroup = create('g', { fill: 'none', stroke: appearance.routeColor, 'stroke-width': String(Math.max(dimensions.widthPx / 150, 10)), 'stroke-linecap': 'round', 'stroke-linejoin': 'round', ...shadowAttributes('route') })
      projection.paths.forEach(path => {
        const d = path.map((point, index) => `${index ? 'L' : 'M'} ${point.x.toFixed(2)} ${point.y.toFixed(2)}`).join(' ')
        routeGroup.appendChild(create('path', { d }))
      })
      artwork.appendChild(routeGroup)
      const textGroup = create('g', { fill: appearance.textColor }) as SVGGElement
      if (settings.title.trim()) {
        const titleGroup = create('g', { fill: appearance.textColor, ...shadowAttributes('title') }) as SVGGElement
        const titleCentered = template.composition === 'classic'
        const titleSize = dimensions.widthPx / (template.composition === 'classic' ? 20 : template.composition === 'minimal' ? 30 : 25)
        addText(titleGroup, settings.title.trim(), dimensions.widthPx * (titleCentered ? 0.5 : 0.12), layout.headerY, titleSize, appearance.textColor, String(appearance.titleFontWeight), titleCentered ? 'middle' : 'start', appearance.titleFontFamily)
        titleGroup.appendChild(create('line', { x1: String(dimensions.widthPx * 0.12), x2: String(dimensions.widthPx * (template.composition === 'minimal' ? 0.35 : 0.88)), y1: String(layout.headerRuleY), y2: String(layout.headerRuleY), stroke: appearance.statisticColor, 'stroke-width': String(Math.max(dimensions.widthPx / 500, 4)), opacity: template.composition === 'minimal' ? '0.7' : '0.45' }))
        textGroup.appendChild(titleGroup)
      }
      const stats = calculateGpxStatistics(selection.gpx, selection.option)
      const unit = settings.distanceUnit as GpxDistanceUnit
      const values: Partial<Record<GpxVisibleStatistic, string>> = {
        distance: formatGpxDistance(stats.distanceMeters, unit),
        recordedTime: stats.recordedTimeSeconds === undefined ? unavailable : formatGpxDuration(stats.recordedTimeSeconds),
        pace: stats.paceSecondsPerKm === undefined ? unavailable : formatGpxPace(stats.paceSecondsPerKm, unit),
        elevationGain: stats.elevationGainMeters === undefined ? unavailable : formatGpxElevation(stats.elevationGainMeters, unit),
        elevationLoss: stats.elevationLossMeters === undefined ? unavailable : formatGpxElevation(stats.elevationLossMeters, unit),
        elevationRange: stats.minimumElevationMeters === undefined || stats.maximumElevationMeters === undefined ? unavailable : `${formatGpxElevation(stats.minimumElevationMeters, unit)} – ${formatGpxElevation(stats.maximumElevationMeters, unit)}`,
        startTime: stats.startTimeMs === undefined ? unavailable : formatGpxDateTime(stats.startTimeMs, locale),
        endTime: stats.endTimeMs === undefined ? unavailable : formatGpxDateTime(stats.endTimeMs, locale),
      }
      const primaryStatisticKey = template.composition === 'stats' ? selectedStatisticKeys.find(key => key === 'distance') ?? selectedStatisticKeys[0] : undefined
      const supportingStatisticKeys = primaryStatisticKey ? selectedStatisticKeys.filter(key => key !== primaryStatisticKey) : selectedStatisticKeys
      if (selectedStatisticKeys.length && template.composition !== 'minimal') {
        const statisticsGroup = create('g', { ...shadowAttributes('statistics') }) as SVGGElement
        statisticsGroup.appendChild(create('rect', { x: String(dimensions.widthPx * 0.09), y: String(layout.statisticsRuleY + 28), width: String(dimensions.widthPx * 0.82), height: String(dimensions.heightPx - layout.statisticsRuleY - 110), fill: backgroundFill, opacity: template.composition === 'stats' ? '0.94' : '0.88' }))
        statisticsGroup.appendChild(create('line', { x1: String(dimensions.widthPx * 0.12), x2: String(dimensions.widthPx * 0.88), y1: String(layout.statisticsRuleY), y2: String(layout.statisticsRuleY), stroke: appearance.statisticColor, 'stroke-width': String(Math.max(dimensions.widthPx / 500, 4)), opacity: '0.45' }))
        textGroup.appendChild(statisticsGroup)
      }
      if (primaryStatisticKey) {
        const x = dimensions.widthPx * 0.12
        const primaryGroup = create('g', { ...shadowAttributes('statistics') }) as SVGGElement
        addText(primaryGroup, labels[primaryStatisticKey], x, layout.primaryStatisticY, dimensions.widthPx / 100, appearance.statisticColor, '500')
        addText(primaryGroup, values[primaryStatisticKey] ?? unavailable, x, layout.primaryStatisticY + dimensions.heightPx * 0.065, dimensions.widthPx / 13, appearance.statisticColor, '700')
        textGroup.appendChild(primaryGroup)
      }
      const supportingStatisticsY = primaryStatisticKey ? layout.primaryStatisticY + dimensions.heightPx * 0.11 : layout.statisticsY
      supportingStatisticKeys.forEach((key, index) => {
        const column = index % template.statisticsColumns
        const row = Math.floor(index / template.statisticsColumns)
        const x = template.statisticsColumns === 1 ? dimensions.widthPx * 0.12 : dimensions.widthPx * (column ? 0.57 : 0.12)
        const y = supportingStatisticsY + row * layout.statisticsRowHeight
        const labelSize = dimensions.widthPx / (template.composition === 'minimal' ? 135 : 105)
        const valueSize = dimensions.widthPx / (template.composition === 'minimal' ? 55 : 40)
        const statisticGroup = create('g', { ...shadowAttributes('statistics') }) as SVGGElement
        addText(statisticGroup, labels[key], x, y, labelSize, appearance.statisticColor, '500')
        addText(statisticGroup, values[key] ?? unavailable, x, y + dimensions.heightPx / 42, valueSize, appearance.statisticColor, '700')
        textGroup.appendChild(statisticGroup)
      })
      artwork.appendChild(textGroup)
      if (template.composition === 'classic') {
        const scaleGroup = create('g', { stroke: appearance.textColor, fill: appearance.textColor, ...shadowAttributes('scale') }) as SVGGElement
        const scaleWidth = dimensions.widthPx * 0.16
        const scaleY = dimensions.heightPx - 150
        scaleGroup.appendChild(create('line', { x1: String(dimensions.widthPx * 0.12), x2: String(dimensions.widthPx * 0.12 + scaleWidth), y1: String(scaleY), y2: String(scaleY), stroke: appearance.textColor, 'stroke-width': String(Math.max(dimensions.widthPx / 240, 6)) }))
        addText(scaleGroup, `${labels.scale}: ${formatGpxDistance(projection.scaleKilometres * 1000, unit)}`, dimensions.widthPx * 0.12, scaleY - 25, dimensions.widthPx / 105, appearance.textColor, '500')
        artwork.appendChild(scaleGroup)
      }
      const summary = locale === 'de' ? `Routen-Artwork mit ${projection.paths.length} sichtbaren Fragmenten, Vorlage ${template.label}.` : `Route artwork with ${projection.paths.length} visible fragments, ${template.label} template.`
      description.textContent = summary
      svg.setAttribute('aria-label', summary)
      setStatus('', true)
      if (meta) meta.textContent = `${template.label} · ${settings.size.toUpperCase()} ${settings.orientation} · ${unit === 'metric' ? 'km / m' : 'mi / ft'}`
    }
    document.addEventListener('gpxselectionchange', event => { selection = (event as CustomEvent<SelectionDetail>).detail; render() })
    document.addEventListener('gpxvisiblemetricschange', event => { visibleStatistics = new Set((event as CustomEvent<string[]>).detail as GpxVisibleStatistic[]); render() })
    document.addEventListener('artworktemplatechange', event => { template = (event as CustomEvent<ArtworkTemplate>).detail; render() })
    document.addEventListener('artworksettingschange', event => { settings = (event as CustomEvent<ArtworkSettings>).detail; render() })
  })
</script>
<style>
  .route-preview { margin-top:48px; }
  .route-preview h2 { margin-bottom:8px; }
  .route-preview-status, .route-preview-meta { color:var(--muted); font-size:var(--font-size-small); }
  .route-preview-frame { display:grid; place-items:center; margin-top:18px; padding:24px; background:var(--wash); border:1px solid var(--line); }
  .route-preview-frame svg { display:block; width:min(100%, 620px); height:auto; max-height:800px; border:1px solid var(--line); box-shadow:0 14px 35px #0005; }
  .route-preview-meta { margin-top:12px; }
</style>
