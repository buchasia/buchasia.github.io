---
import ArtworkSettingsPanel from './ArtworkSettingsPanel.astro'
import ArtworkTemplatePicker from './ArtworkTemplatePicker.astro'
import GpxUploadPanel from './GpxUploadPanel.astro'
import RoutePosterPreview from './RoutePosterPreview.astro'
import type { Lang } from '../utils/i18n'

type Props = { lang: Lang }
const { lang } = Astro.props
const de = lang === 'de'
---
<div class="visualizer-workflow" data-visualizer-workflow data-locale={lang}>
  <section class="workflow-step" data-workflow-step="upload" aria-labelledby={`upload-step-title-${lang}`}>
    <p class="eyebrow">{de ? 'Schritt 1 von 2' : 'Step 1 of 2'}</p>
    <h2 id={`upload-step-title-${lang}`} tabindex="-1" data-workflow-upload-heading>{de ? 'GPX-Datei auswählen' : 'Choose a GPX file'}</h2>
    <p>{de ? 'Lade deine Route lokal im Browser, bevor du das Artwork gestaltest.' : 'Load your route locally in the browser before designing the artwork.'}</p>
    <GpxUploadPanel lang={lang} />
    <button type="button" class="workflow-continue" data-workflow-continue disabled>{de ? 'Weiter zur Gestaltung' : 'Continue to design'}</button>
  </section>
  <section class="workflow-step workflow-design-step" data-workflow-step="design" aria-labelledby={`design-step-title-${lang}`} hidden>
    <div class="workflow-heading-row">
      <div><p class="eyebrow">{de ? 'Schritt 2 von 2' : 'Step 2 of 2'}</p><h2 id={`design-step-title-${lang}`} tabindex="-1" data-workflow-design-heading>{de ? 'Artwork gestalten' : 'Design your artwork'}</h2></div>
      <button type="button" class="workflow-back" data-workflow-back>{de ? 'Zurück zur Datei' : 'Back to file'}</button>
    </div>
    <div class="workflow-design-grid">
      <aside class="workflow-controls" aria-label={de ? 'Artwork-Einstellungen' : 'Artwork controls'}>
        <ArtworkTemplatePicker lang={lang} />
        <ArtworkSettingsPanel lang={lang} />
      </aside>
      <main class="workflow-preview"><RoutePosterPreview lang={lang} /></main>
    </div>
  </section>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-visualizer-workflow]').forEach((workflow) => {
    const uploadStep = workflow.querySelector<HTMLElement>('[data-workflow-step="upload"]')
    const designStep = workflow.querySelector<HTMLElement>('[data-workflow-step="design"]')
    const continueButton = workflow.querySelector<HTMLButtonElement>('[data-workflow-continue]')
    const backButton = workflow.querySelector<HTMLButtonElement>('[data-workflow-back]')
    const uploadHeading = workflow.querySelector<HTMLElement>('[data-workflow-upload-heading]')
    const designHeading = workflow.querySelector<HTMLElement>('[data-workflow-design-heading]')
    let hasRoute = false
    let currentStep: 'upload' | 'design' = 'upload'
    const showStep = (step: 'upload' | 'design', focus = true) => {
      currentStep = step
      if (uploadStep) uploadStep.hidden = step !== 'upload'
      if (designStep) designStep.hidden = step !== 'design'
      if (focus) (step === 'upload' ? uploadHeading : designHeading)?.focus()
    }
    workflow.addEventListener('gpxselectionchange', () => {
      hasRoute = true
      if (continueButton) continueButton.disabled = false
      if (currentStep === 'design') showStep('upload')
    })
    workflow.addEventListener('gpxreset', () => {
      hasRoute = false
      if (continueButton) continueButton.disabled = true
      showStep('upload')
    })
    continueButton?.addEventListener('click', () => { if (hasRoute) showStep('design') })
    backButton?.addEventListener('click', () => showStep('upload'))
    showStep('upload', false)
  })
</script>
<style>
  .visualizer-workflow { margin-top:48px; }
  .workflow-step > h2 { margin-bottom:10px; }
  .workflow-step > p:not(.eyebrow) { color:var(--muted); font-family:'Source Serif 4',serif; font-size:var(--font-size-reading); }
  .workflow-continue, .workflow-back { padding:10px 15px; border:1px solid var(--accent); background:var(--accent); color:#071016; cursor:pointer; font:inherit; font-size:var(--font-size-small); }
  .workflow-continue:disabled { border-color:var(--line); background:var(--wash); color:var(--muted); cursor:not-allowed; }
  .workflow-heading-row { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:28px; }
  .workflow-heading-row h2 { margin:0; }
  .workflow-back { border-color:var(--line); background:transparent; color:var(--ink); }
  .workflow-design-grid { display:grid; grid-template-columns:minmax(280px, 360px) minmax(0, 1fr); gap:38px; align-items:start; }
  .workflow-controls { display:grid; gap:26px; position:sticky; top:20px; }
  .workflow-controls .artwork-settings { max-width:none; padding:20px; }
  .workflow-preview { min-width:0; }
  .workflow-preview .route-preview { margin-top:0; }
  @media (max-width: 760px) { .workflow-design-grid { grid-template-columns:1fr; gap:28px; } .workflow-controls { position:static; } .workflow-heading-row { align-items:flex-start; flex-direction:column; } }
</style>
