---
import BookCover from './BookCover.astro'
import { getBookEntries, getBookIsbn, getBookShelfGroups, getBookYearSummaries, type Book } from '../utils/books'
import { localizedPath, t, type Lang } from '../utils/i18n'

type Props = { lang: Lang; books: Book[] }
const { lang, books } = Astro.props
const dict = t(lang).books
getBookEntries(books)
const { reading, remaining } = getBookShelfGroups(books)
const shelves = [
  { books: reading, label: dict.currentlyReading },
  ...getBookYearSummaries(remaining).reverse().map((summary) => ({ books: summary.books, label: String(summary.year) })),
]
---
<section class="books-page">
  <h1>{dict.title}</h1>
  {books.length === 0 && <p class="books-empty">{dict.emptyShelf}</p>}
  {shelves.filter((shelf) => shelf.books.length > 0).map((shelf) => (
    <section class="bookshelf-section" aria-label={shelf.label || dict.collection}>
      {shelf.label && <h2>{shelf.label}</h2>}
      <ul class="bookshelf">
        {shelf.books.map((book) => (
          <li>
            <a class="bookshelf-book" href={localizedPath(lang, `/books/${getBookIsbn(book)}/`)} aria-label={`${book.title} - ${book.author}`} title={`${book.title} - ${book.author}`}>
              <BookCover book={book} lang={lang} />
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</section>
