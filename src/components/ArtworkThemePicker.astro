---
import { ARTWORK_THEMES, DEFAULT_ARTWORK_THEME, type ArtworkThemeId } from '../utils/artworkThemes'
import type { Lang } from '../utils/i18n'

type Props = { lang: Lang }
const { lang } = Astro.props
const de = lang === 'de'
const labels = de
  ? { legend: 'Artwork-Stil', paper: 'Papier', night: 'Nacht', botanical: 'Botanisch' }
  : { legend: 'Artwork theme', paper: 'Paper', night: 'Night', botanical: 'Botanical' }
const themeLabels: Record<ArtworkThemeId, string> = { paper: labels.paper, night: labels.night, botanical: labels.botanical }
---
<fieldset class="theme-picker" data-artwork-theme-picker data-locale={lang}>
  <legend>{labels.legend}</legend>
  <label class="picker-label" for={`artwork-theme-${lang}`}>{labels.legend}</label>
  <div class="theme-select-row">
    <select id={`artwork-theme-${lang}`} name={`artwork-theme-${lang}`} data-artwork-theme-select>
    {Object.values(ARTWORK_THEMES).map(theme => (
      <option value={theme.id} selected={theme.id === DEFAULT_ARTWORK_THEME}>{themeLabels[theme.id]}</option>
    ))}
    </select>
    <span class="theme-swatch" data-theme-swatch aria-hidden="true"><span></span></span>
  </div>
</fieldset>
<script>
  import { getArtworkTheme, type ArtworkThemeId } from '../utils/artworkThemes'

  document.querySelectorAll<HTMLElement>('[data-artwork-theme-picker]').forEach((picker) => {
    const select = picker.querySelector<HTMLSelectElement>('[data-artwork-theme-select]')
    const swatch = picker.querySelector<HTMLElement>('[data-theme-swatch]')
    const announce = (themeId: string) => {
      const theme = getArtworkTheme(themeId)
      picker.dispatchEvent(new CustomEvent('artworkthemechange', { bubbles: true, detail: theme }))
      picker.dataset.selectedTheme = theme.id
      if (swatch) {
        swatch.style.background = theme.background
        swatch.style.borderColor = theme.textColor
        const routeSwatch = swatch.querySelector<HTMLElement>('span')
        if (routeSwatch) routeSwatch.style.background = theme.routeColor
      }
    }
    select?.addEventListener('change', () => announce(select.value as ArtworkThemeId))
    if (select) announce(select.value)
  })
</script>
<style>
  .theme-picker { margin:28px 0 0; padding:0; border:0; }
  .theme-picker legend { margin-bottom:12px; color:var(--ink); font-size:var(--font-size-small); font-weight:700; }
  .picker-label { display:block; margin-bottom:6px; color:var(--muted); font-size:var(--font-size-label); }
  .theme-select-row { display:flex; align-items:center; gap:10px; }
  .theme-select-row select { flex:1; }
  .theme-swatch { display:grid; place-items:center; width:24px; height:24px; border:2px solid; border-radius:50%; }
  .theme-swatch span { width:10px; height:10px; border-radius:50%; }
</style>
