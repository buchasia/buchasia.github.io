---
import { ARTWORK_TEMPLATES, DEFAULT_ARTWORK_TEMPLATE, type ArtworkTemplateId } from '../utils/artworkTemplates'
import type { Lang } from '../utils/i18n'

type Props = { lang: Lang }
const { lang } = Astro.props
const de = lang === 'de'
const labels = de
  ? { legend: 'Vorlage', classic: 'Klassisch', minimal: 'Minimal', stats: 'Statistiken', classicDescription: 'Zentrierte Route mit Titel und Statistiken im Fußbereich.', minimalDescription: 'Route im Mittelpunkt mit großzügigem Weißraum.', statsDescription: 'Route oben und strukturierter Statistikbereich darunter.' }
  : { legend: 'Template', classic: 'Classic', minimal: 'Minimal', stats: 'Stats', classicDescription: 'Centered route with title and footer statistics.', minimalDescription: 'Route-dominant composition with generous whitespace.', statsDescription: 'Route above a structured statistics section.' }
const templateLabels: Record<ArtworkTemplateId, { label: string; description: string }> = {
  classic: { label: labels.classic, description: labels.classicDescription },
  minimal: { label: labels.minimal, description: labels.minimalDescription },
  stats: { label: labels.stats, description: labels.statsDescription },
}
---
<fieldset class="template-picker" data-artwork-template-picker>
  <legend>{labels.legend}</legend>
  <label class="picker-label" for={`artwork-template-${lang}`}>{labels.legend}</label>
  <select id={`artwork-template-${lang}`} name={`artwork-template-${lang}`} data-artwork-template-select>
    {Object.values(ARTWORK_TEMPLATES).map(template => (
      <option value={template.id} selected={template.id === DEFAULT_ARTWORK_TEMPLATE} data-description={templateLabels[template.id].description}>{templateLabels[template.id].label}</option>
    ))}
  </select>
  <p class="picker-description" data-artwork-template-description></p>
</fieldset>
<script>
  import { getArtworkTemplate, type ArtworkTemplateId } from '../utils/artworkTemplates'

  document.querySelectorAll<HTMLElement>('[data-artwork-template-picker]').forEach((picker) => {
    const select = picker.querySelector<HTMLSelectElement>('[data-artwork-template-select]')
    const description = picker.querySelector<HTMLElement>('[data-artwork-template-description]')
    const announce = (id: string) => {
      const template = getArtworkTemplate(id)
      const option = select?.selectedOptions[0]
      if (description) description.textContent = option?.dataset.description ?? template.description
      picker.dispatchEvent(new CustomEvent('artworktemplatechange', { bubbles: true, detail: template }))
    }
    select?.addEventListener('change', () => announce(select.value as ArtworkTemplateId))
    if (select) announce(select.value)
  })
</script>
<style>
  .template-picker { margin:0; padding:0; border:0; }
  .template-picker legend { margin-bottom:12px; color:var(--ink); font-size:var(--font-size-small); font-weight:700; }
  .picker-label { display:block; margin-bottom:6px; color:var(--muted); font-size:var(--font-size-label); }
  .template-picker select, .theme-picker select { width:100%; padding:10px 12px; border:1px solid var(--line); border-radius:0; background:var(--wash); color:var(--ink); font:inherit; font-size:var(--font-size-small); }
  .template-picker select:focus-visible, .theme-picker select:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
  .picker-description { margin:8px 0 0; color:var(--muted); font-size:var(--font-size-label); line-height:1.4; }
</style>
