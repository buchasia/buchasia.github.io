{
  "$schema": "run-template-definition/v1",
  "version": 1,
  "id": "stats",
  "name": { "en": "Stats", "de": "Statistiken" },
  "description": { "en": "A metric-led poster with a prominent distance and supporting route.", "de": "Ein metrisches Poster mit prominenter Distanz und unterstützender Route." },
  "composition": "stats",
  "layout": { "routePadding": 140, "statisticsColumns": 2 },
  "appearance": {
    "background": "#FFFFFF",
    "routeColor": "#7C3AED",
    "textColor": "#211A2D",
    "statisticColor": "#211A2D",
    "footerColor": "#5B21B6",
    "titleFontFamily": "Source Serif 4",
    "bodyFontFamily": "DM Sans",
    "titleFontWeight": 700
  },
  "settings": {
    "shadows": {
      "title": { "enabled": true, "color": "#000000", "blur": 18, "offsetX": 0, "offsetY": 8, "opacity": 0.28 },
      "statistics": { "enabled": true, "color": "#000000", "blur": 12, "offsetX": 0, "offsetY": 5, "opacity": 0.2 }
    }
  },
  "editor": []
}
