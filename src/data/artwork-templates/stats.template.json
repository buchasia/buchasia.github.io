{
  "$schema": "run-template-definition/v1",
  "version": 1,
  "id": "stats",
  "name": { "en": "Stats", "de": "Statistiken" },
  "description": { "en": "A metric-led poster with a prominent distance and supporting route.", "de": "Ein metrisches Poster mit prominenter Distanz und unterstützender Route." },
  "layout": {
    "routePadding": 140,
    "route": { "strokeWidthRatio": 0.006667, "minStrokeWidth": 10, "linecap": "round", "linejoin": "round" },
    "header": {
      "title": { "xRatio": 0.12, "yRatio": 0.105, "sizeRatio": 0.04, "weight": 700, "anchor": "start" },
      "rule": { "x1Ratio": 0.12, "x2Ratio": 0.88, "yWithTitleRatio": 0.15, "yWithoutTitleRatio": 0.11, "strokeWidthRatio": 0.002, "opacity": 0.45 },
      "routeTopPaddingRatio": 0.025
    },
    "statistics": {
      "columns": 2,
      "rowHeightRatio": 0.045,
      "minRowHeight": 104,
      "blockTopPadding": 70,
      "bottomPaddingRatio": 0.07,
      "rule": { "x1Ratio": 0.12, "x2Ratio": 0.88, "strokeWidthRatio": 0.002, "opacity": 0.45 },
      "panel": { "enabled": true, "xRatio": 0.09, "widthRatio": 0.82, "yOffset": 28, "bottomOffset": 110, "opacity": 0.94 },
      "primaryMetric": "distance",
      "primary": { "labelSizeRatio": 0.01, "valueSizeRatio": 0.076923, "valueYOffsetRatio": 0.065, "supportingOffsetRatio": 0.11 },
      "supporting": { "startOffset": 58, "columnXRatios": [0.12, 0.57], "labelSizeRatio": 0.009524, "valueSizeRatio": 0.025 }
    },
    "scale": { "enabled": false, "xRatio": 0.12, "yOffset": 150, "widthRatio": 0.16, "strokeWidthRatio": 0.004167, "minStrokeWidth": 6, "labelOffset": 25, "labelSizeRatio": 0.009524 }
  },
  "appearance": {
    "background": "#FFFFFF",
    "routeColor": "#7C3AED",
    "textColor": "#211A2D",
    "statisticColor": "#211A2D",
    "footerColor": "#5B21B6",
    "titleFontFamily": "Source Serif 4",
    "bodyFontFamily": "DM Sans",
    "titleFontWeight": 700,
    "bodyFontWeight": 400,
    "statisticLabelWeight": 500,
    "statisticValueWeight": 700,
    "scaleWeight": 500
  },
  "settings": {
    "shadows": {
      "title": { "enabled": true, "color": "#000000", "blur": 18, "offsetX": 0, "offsetY": 8, "opacity": 0.28 },
      "statistics": { "enabled": true, "color": "#000000", "blur": 12, "offsetX": 0, "offsetY": 5, "opacity": 0.2 }
    }
  },
  "editor": []
}
