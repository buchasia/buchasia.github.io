{
  "$schema": "run-template-definition/v2",
  "version": 2,
  "id": "city-half-marathon-poster",
  "name": { "en": "City Half Marathon Poster", "de": "Stadt-Halbmarathon-Poster" },
  "description": {
    "en": "A compact dark finisher card with a prominent distance, GPS route and three supporting metrics.",
    "de": "Eine kompakte dunkle Finisher-Karte mit großer Distanz, GPS-Route und drei weiteren Kennzahlen."
  },
  "output": {
    "widthPx": 620,
    "heightPx": 445,
    "sizeDescription": { "en": "Digital poster · 620 × 445 px", "de": "Digitales Poster · 620 × 445 px" }
  },
  "layout": {
    "routePadding": 34,
    "route": { "strokeWidthRatio": 0.0048, "minStrokeWidth": 3, "linecap": "round", "linejoin": "round" },
    "header": {
      "title": { "xRatio": 0.055, "yRatio": 0.13, "sizeRatio": 0.031, "weight": 600, "anchor": "start" },
      "rule": { "x1Ratio": 0.055, "x2Ratio": 0.945, "yWithTitleRatio": 0.17, "yWithoutTitleRatio": 0.1, "strokeWidthRatio": 0.002, "opacity": 0.45 },
      "routeTopPaddingRatio": 0.025
    },
    "statistics": {
      "visibleStatistics": ["distance", "recordedTime", "pace", "startTime"],
      "columns": 3,
      "rowHeightRatio": 0.07,
      "minRowHeight": 30,
      "blockTopPadding": 20,
      "bottomPaddingRatio": 0.06,
      "rule": { "x1Ratio": 0.055, "x2Ratio": 0.945, "strokeWidthRatio": 0.002, "opacity": 0.45 },
      "panel": { "enabled": true, "xRatio": 0.04, "widthRatio": 0.92, "yOffset": 12, "bottomOffset": 20, "opacity": 0.88 },
      "primaryMetric": "distance",
      "primary": { "labelSizeRatio": 0.022, "valueSizeRatio": 0.255, "valueYOffsetRatio": 0.065, "supportingOffsetRatio": 0.06 },
      "supporting": { "startOffset": 20, "columnXRatios": [0.055, 0.37, 0.685], "labelSizeRatio": 0.018, "valueSizeRatio": 0.034 }
    },
    "scale": {
      "enabled": false,
      "xRatio": 0.055,
      "yOffset": 18,
      "widthRatio": 0.16,
      "strokeWidthRatio": 0.004,
      "minStrokeWidth": 2,
      "labelOffset": 8,
      "labelSizeRatio": 0.016
    }
  },
  "appearance": {
    "background": "#13202A",
    "routeColor": "#F5BB6C",
    "textColor": "#F8F4E8",
    "statisticColor": "#BDC8CA",
    "footerColor": "#BDC8CA",
    "titleFontFamily": "Source Serif 4",
    "bodyFontFamily": "DM Sans",
    "titleFontWeight": 600,
    "bodyFontWeight": 400,
    "statisticLabelWeight": 400,
    "statisticValueWeight": 500,
    "scaleWeight": 400
  },
  "settings": { "shadows": {} },
  "editor": [
    { "id": "background", "type": "color", "path": "appearance.background", "label": { "en": "Background", "de": "Hintergrund" } },
    { "id": "textColor", "type": "color", "path": "appearance.textColor", "label": { "en": "Main text", "de": "Haupttext" } },
    { "id": "routeColor", "type": "color", "path": "appearance.routeColor", "label": { "en": "Route accent", "de": "Routenakzent" } },
    { "id": "statisticColor", "type": "color", "path": "appearance.statisticColor", "label": { "en": "Statistic text", "de": "Statistiktext" } }
  ]
}
