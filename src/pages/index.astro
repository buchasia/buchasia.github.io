---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostRow from '../components/PostRow.astro'
import { PAGE_SIZE, sortPostsByDate } from '../utils/posts'

const posts = sortPostsByDate(await getCollection('blog'))
---
<BaseLayout>
  <section class="hero">
    <div>
      <h1>Cogito Ergo Sum</h1>
    </div>
    <div class="hero-copy">
      <p>Hello and welcome to my blog.</p>
      <p>A father, wanderer, lifelong learner, runner, and software engineer writing about technology, data, mathematics, and the spaces between them.</p>
    </div>
  </section>
  <section class="intro">
    <span class="section-label">Current interests</span>
    <p>Fabric · Power BI · Running · Numbers · AI · Mathematics</p>
  </section>
  <section class="posts">
    <div class="section-label">Recent posts</div>
    {posts.slice(0, PAGE_SIZE).map((post) => <PostRow post={post} />)}
  </section>
</BaseLayout>
