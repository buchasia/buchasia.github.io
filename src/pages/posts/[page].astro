---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostArchive from '../../components/PostArchive.astro'
import { PAGE_SIZE, getBlogPosts, sortPostsByDate } from '../../utils/posts'

export async function getStaticPaths() {
  const posts = sortPostsByDate(await getBlogPosts())
  const totalPages = Math.ceil(posts.length / PAGE_SIZE)

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2
    return {
      params: { page: String(currentPage) },
      props: {
        posts: posts.slice(index * PAGE_SIZE + PAGE_SIZE, currentPage * PAGE_SIZE),
        currentPage,
        totalPages,
      },
    }
  })
}

const { posts, currentPage, totalPages } = Astro.props
---
<BaseLayout title={`Posts - Page ${currentPage}`}>
  <section class="about">
    <p class="eyebrow">Archive</p>
    <h1>All posts</h1>
    <PostArchive posts={posts} currentPage={currentPage} totalPages={totalPages} />
  </section>
</BaseLayout>
