---
import { render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { slugifyTag } from '../../utils/tags'
import { formatDate, formatReadingTime, getBlogPosts, getReadingTime } from '../../utils/posts'

export async function getStaticPaths() {
  const posts = await getBlogPosts()
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const readingTime = getReadingTime(post)
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article">
    <header class="article-header">
      <p class="eyebrow">Essay</p>
      <h1>{post.data.title}</h1>
      <p class="article-date">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {readingTime.minutes > 0 && (
          <span class="reading-time">{formatReadingTime(readingTime, true)}</span>
        )}
      </p>
      {post.data.tags.length > 0 && (
        <nav class="post-tags" aria-label="Post tags">
          {post.data.tags.map((tag) => <a href={`/tags/${slugifyTag(tag)}/`}>{tag}</a>)}
        </nav>
      )}
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
