---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostArchive from '../../components/PostArchive.astro'
import { PAGE_SIZE, getBlogPosts, sortPostsByDate } from '../../utils/posts'

const posts = sortPostsByDate(await getBlogPosts())
---
<BaseLayout title="Posts">
  <section class="about">
    <p class="eyebrow">Archive</p>
    <h1>All posts</h1>
    <PostArchive posts={posts.slice(0, PAGE_SIZE)} currentPage={1} totalPages={Math.ceil(posts.length / PAGE_SIZE)} />
  </section>
</BaseLayout>
