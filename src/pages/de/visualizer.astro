---
import BaseLayout from '../../layouts/BaseLayout.astro'
import GpxUploadPanel from '../../components/GpxUploadPanel.astro'
---
<BaseLayout title="Routen-Visualizer" lang="de" altPath="/visualizer/">
  <section class="about">
    <p class="eyebrow">Lauf-Artwork</p>
