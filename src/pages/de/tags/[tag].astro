---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { slugifyTag } from '../../../utils/tags'
import PostRow from '../../../components/PostRow.astro'
import { getBlogPosts, getUniqueTags } from '../../../utils/posts'
import { t } from '../../../utils/i18n'

export async function getStaticPaths() {
  const posts = await getBlogPosts('de')
  const tags = getUniqueTags(posts)

  return tags.map((tag) => ({
    params: { tag: slugifyTag(tag) },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }))
}

const { tag, posts } = Astro.props
const dict = t('de')
---
<BaseLayout title={`Thema: ${tag}`} lang="de" altPath={`/tags/${slugifyTag(tag)}/`}>
  <section class="about">
    <p class="eyebrow">{dict.tagPage.eyebrow}</p>
    <h1>{tag}</h1>
    <div class="posts">
      {posts.map((post) => <PostRow post={post} lang="de" headingLevel="h2" />)}
    </div>
  </section>
</BaseLayout>
