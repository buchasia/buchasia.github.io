---
import books from '../../../../content/data/books.json'
import library from '../../../../content/data/library.json'
import BookDetailPage from '../../../components/BookDetailPage.astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getBookEntries, joinLibraryAndReading, type LibraryBook, type ReadingBook } from '../../../utils/books'

export function getStaticPaths() {
  const merged = joinLibraryAndReading(library as LibraryBook[], books as ReadingBook[])
  return getBookEntries(merged).filter(({ book }) => book.yearRead > 0).map(({ isbn, book }) => ({ params: { isbn }, props: { book, isbn } }))
}

const { book, isbn } = Astro.props
---
<BaseLayout title={book.title} description={`${book.title} von ${book.author}. Lesefortschritt und Notizen.`} lang="de" altPath={`/books/${isbn}/`}>
  <BookDetailPage book={book} lang="de" />
</BaseLayout>