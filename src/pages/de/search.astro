---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostRow from '../../components/PostRow.astro'
import { getBlogPosts, sortPostsByDate } from '../../utils/posts'
import { t } from '../../utils/i18n'

const dict = t('de')
const posts = sortPostsByDate(await getBlogPosts('de'))
---
<BaseLayout title={dict.search.title} lang="de" altPath="/search/">
  <section class="about search-page">
    <p class="eyebrow">{dict.search.eyebrow}</p>
    <h1>{dict.search.title}</h1>
    <label class="search-label" for="post-search">{dict.search.label}</label>
    <input id="post-search" class="search-input" type="search" placeholder={dict.search.placeholder} />
    <p id="search-status" class="search-status">{dict.search.showingAllTemplate.replace('{n}', String(posts.length))}</p>
    <div id="search-results" class="posts">
      {posts.map((post) => <PostRow post={post} lang="de" className="search-result" searchable />)}
    </div>
  </section>
</BaseLayout>
<script is:inline define:vars={{
  showingAllTemplate: dict.search.showingAllTemplate,
  matchingSingularTemplate: dict.search.matchingSingularTemplate,
  matchingPluralTemplate: dict.search.matchingPluralTemplate,
}}>
  const input = document.querySelector('#post-search')
  const results = [...document.querySelectorAll('.search-result')]
  const status = document.querySelector('#search-status')

  input?.addEventListener('input', (event) => {
    const query = event.currentTarget.value.trim().toLowerCase()
    let visible = 0
    results.forEach((result) => {
      const matches = !query || (result.dataset.search ?? '').toLowerCase().includes(query)
      result.hidden = !matches
      if (matches) visible += 1
    })
    if (status) {
      const template = !query
        ? showingAllTemplate
        : visible === 1
          ? matchingSingularTemplate
          : matchingPluralTemplate
      status.textContent = template.replace('{n}', String(visible))
    }
  })
</script>
