---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostRow from '../../components/PostRow.astro'
import { PAGE_SIZE, getBlogPosts, sortPostsByDate } from '../../utils/posts'
import { t } from '../../utils/i18n'

const dict = t('de')
const posts = sortPostsByDate(await getBlogPosts('de'))
---
<BaseLayout lang="de" altPath="/">
  <section class="hero">
    <div>
      <h1>{dict.home.title}</h1>
    </div>
    <div class="hero-copy">
      <p>{dict.home.intro1}</p>
      <p>{dict.home.intro2}</p>
    </div>
  </section>
  <section class="intro">
    <span class="section-label">{dict.home.currentInterests}</span>
    <p>{dict.home.interests}</p>
  </section>
  <section class="posts">
    <div class="section-label">{dict.home.recentPosts}</div>
    {posts.slice(0, PAGE_SIZE).map((post) => <PostRow post={post} lang="de" />)}
  </section>
</BaseLayout>
